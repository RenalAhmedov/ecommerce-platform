{
  "info": {
    "name": "E-commerce API Gateway",
    "description": "Manual test suite for the Nest.js API gateway. Run the folders top to bottom (or the whole collection with the Runner).\n\nBefore you start:\n1. `docker compose up -d` (root) and `npm run start:dev` (api-gateway).\n2. Run \"1. Auth > Register admin\", then promote it once in SQL:\n   UPDATE users SET role = 'admin' WHERE email = 'admin@example.test';\n3. Mailpit (emails): http://localhost:8025  |  Swagger: http://localhost:3000/api/docs\n\nRate limits: register 3/min and login 5/min per IP. Running \"1. Auth\" twice within a minute will hit 429 - wait a minute.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "otherCustomerToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "sessionToken",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "hiddenProductId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201 or 409', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ada Customer\",\n  \"email\": \"customer@example.test\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "201 the first time, 409 \"Email is already registered\" afterwards (both fine). DB: users table, password is a bcrypt $2b$12$ hash."
          }
        },
        {
          "name": "Register second customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201 or 409', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob Customer\",\n  \"email\": \"other@example.test\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Register admin (then promote with SQL)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201 or 409', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin\",\n  \"email\": \"admin@example.test\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Registration always creates a customer. Promote once in SQL:\nUPDATE users SET role = 'admin' WHERE email = 'admin@example.test';"
          }
        },
        {
          "name": "Login customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('customerToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.test\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Paste the accessToken into https://jwt.io to see the claims: sub, email, role, jti (unique per login), iat, exp."
          }
        },
        {
          "name": "Login second customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('otherCustomerToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"other@example.test\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('role is admin (run the SQL promotion if this fails)', () => pm.expect(pm.response.json().user.role).to.eql('admin'));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.test\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Me (customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('no password in the response', () => pm.expect(pm.response.json()).to.not.have.property('password'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "2. Products - admin",
      "item": [
        {
          "name": "Create product (stock 5)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const p = pm.response.json();",
                  "pm.test('sku upper-cased, slug generated, price as money string', () => { pm.expect(p.sku).to.match(/^KB-/); pm.expect(p.slug).to.match(/^keyboard-/); pm.expect(p.price).to.eql('12.50'); pm.expect(p.stock).to.eql(5); });",
                  "pm.collectionVariables.set('productId', p.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Keyboard {{$timestamp}}\",\n  \"sku\": \"kb-{{$timestamp}}\",\n  \"description\": \"Mechanical keyboard\",\n  \"price\": 12.5,\n  \"initialStock\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/products",
            "description": "DB: products, inventories (quantity 5) and inventory_movements (+5 \"initial\"). Redis: products:cache-version was incremented."
          }
        },
        {
          "name": "Create hidden product (isActive false)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('hiddenProductId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Hidden {{$timestamp}}\",\n  \"sku\": \"hidden-{{$timestamp}}\",\n  \"price\": 1,\n  \"initialStock\": 10,\n  \"isActive\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/products"
          }
        },
        {
          "name": "Update product price",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('updated', () => pm.expect(pm.response.json().description).to.include('brown'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 12.5,\n  \"description\": \"Mechanical keyboard, brown switches\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/products/{{productId}}"
          }
        }
      ]
    },
    {
      "name": "3. Products - public (cached in Redis)",
      "item": [
        {
          "name": "List products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('paginated', () => pm.expect(pm.response.json().meta).to.include.keys('page', 'limit', 'total', 'totalPages'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/products",
            "description": "Send twice. Medis/redis-cli: a key products:v<N>:list:<hash> appears with a TTL of 60 s; the second call is served from it."
          }
        },
        {
          "name": "List with filters and sorting",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/products?search=keyboard&minPrice=10&maxPrice=100&sortBy=price&sortOrder=asc&page=1&limit=10"
          }
        },
        {
          "name": "Get product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('stock is visible', () => pm.expect(pm.response.json()).to.have.property('stock'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/products/{{productId}}",
            "description": "Cached as products:v<N>:detail:<id>."
          }
        },
        {
          "name": "Hidden product is not public (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/products/{{hiddenProductId}}"
          }
        }
      ]
    },
    {
      "name": "4. Orders",
      "item": [
        {
          "name": "Place order (2 units, with Idempotency-Key)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const o = pm.response.json();",
                  "pm.test('paid, total 25.00, price snapshot', () => { pm.expect(o.status).to.eql('paid'); pm.expect(o.total).to.eql('25.00'); pm.expect(o.items[0].unitPrice).to.eql('12.50'); pm.expect(o.paymentReference).to.match(/^mock_/); });",
                  "pm.collectionVariables.set('orderId', o.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": {{productId}},\n      \"quantity\": 2\n    }\n  ],\n  \"shippingAddress\": {\n    \"fullName\": \"Ada Lovelace\",\n    \"line1\": \"1 Main St\",\n    \"city\": \"Sofia\",\n    \"postalCode\": \"1000\",\n    \"country\": \"bg\"\n  },\n  \"paymentToken\": \"tok_visa\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/orders",
            "description": "Check afterwards:\n- Mailpit (http://localhost:8025): \"Your order ORD-... is confirmed\" sent to customer@example.test\n- DB: orders (paid), order_items, inventory_movements (-2 \"sale\"), inventories quantity 3\n- Redis: idempotency:OrdersController.create:<userId>:<key> stored for 24h; bull:order-emails:completed"
          }
        },
        {
          "name": "Retry with the same Idempotency-Key -> same order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('same order replayed', () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('orderId'))));",
                  "pm.test('Idempotent-Replayed header', () => pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.eql('true'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": {{productId}},\n      \"quantity\": 2\n    }\n  ],\n  \"shippingAddress\": {\n    \"fullName\": \"Ada Lovelace\",\n    \"line1\": \"1 Main St\",\n    \"city\": \"Sofia\",\n    \"postalCode\": \"1000\",\n    \"country\": \"bg\"\n  },\n  \"paymentToken\": \"tok_visa\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/orders",
            "description": "No second order, no second charge, no second email, stock still 3."
          }
        },
        {
          "name": "Same Idempotency-Key, different body -> 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 422', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": {{productId}},\n      \"quantity\": 1\n    }\n  ],\n  \"shippingAddress\": {\n    \"fullName\": \"Ada Lovelace\",\n    \"line1\": \"1 Main St\",\n    \"city\": \"Sofia\",\n    \"postalCode\": \"1000\",\n    \"country\": \"bg\"\n  },\n  \"paymentToken\": \"tok_visa\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/orders"
          }
        },
        {
          "name": "Declined card -> 402, stock released",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 402', () => pm.response.to.have.status(402));",
                  "pm.test('message mentions \"Payment was declined\"', () => pm.expect(JSON.stringify(pm.response.json().message)).to.include(\"Payment was declined\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": {{productId}},\n      \"quantity\": 1\n    }\n  ],\n  \"shippingAddress\": {\n    \"fullName\": \"Ada Lovelace\",\n    \"line1\": \"1 Main St\",\n    \"city\": \"Sofia\",\n    \"postalCode\": \"1000\",\n    \"country\": \"bg\"\n  },\n  \"paymentToken\": \"tok_declined\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/orders",
            "description": "DB: a payment_failed order with movements -1 \"sale\" and +1 \"cancellation\". No email. Stock stays 3."
          }
        },
        {
          "name": "Not enough stock -> 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('message mentions \"Insufficient stock\"', () => pm.expect(JSON.stringify(pm.response.json().message)).to.include(\"Insufficient stock\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": {{productId}},\n      \"quantity\": 100\n    }\n  ],\n  \"shippingAddress\": {\n    \"fullName\": \"Ada Lovelace\",\n    \"line1\": \"1 Main St\",\n    \"city\": \"Sofia\",\n    \"postalCode\": \"1000\",\n    \"country\": \"bg\"\n  },\n  \"paymentToken\": \"tok_visa\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/orders",
            "description": "Nothing is created: no order row, stock unchanged."
          }
        },
        {
          "name": "Hidden product -> 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('message mentions \"Products not available\"', () => pm.expect(JSON.stringify(pm.response.json().message)).to.include(\"Products not available\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
