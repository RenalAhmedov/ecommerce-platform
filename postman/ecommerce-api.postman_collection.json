    {
      "name": "7. Rate limiting (run last)",
      "item": [
        {
          "name": "Login - send this 6 times quickly",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401 or 429', () => pm.expect([401, 429]).to.include(pm.response.code));",
                  "if (pm.response.code === 429) { pm.test('blocked: Retry-After header', () => pm.expect(Number(pm.response.headers.get('Retry-After'))).to.be.above(0)); }",
                  "else { pm.test('allowed: X-RateLimit-Remaining header', () => pm.expect(pm.response.headers.has('X-RateLimit-Remaining')).to.be.true); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.test\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Login allows 5 attempts per minute per IP. Click Send 6 times: the 6th answers 429 with Retry-After. Redis: rate-limit:default:<hash>. After this, logins from your IP are blocked for up to a minute."
          }
        }
