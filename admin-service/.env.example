APP_NAME="Shop Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# stderr: logs appear in `docker compose logs admin-service` / `admin-worker`
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Live updates in the panel: Laravel Reverb (WebSocket server, the `reverb` container)
# and Echo in the browser. The key is public (it is sent to browsers), the secret is not.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=ecommerce-admin
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where this app sends broadcasts, inside Docker; browsers connect through Nginx (/app) instead.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

CACHE_STORE=redis
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX="admin:"

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@shop.local"
MAIL_FROM_NAME="${APP_NAME}"

# Must equal JWT_SECRET in api-gateway/.env
JWT_SECRET=

# The Nest api-gateway, told about catalogue changes through its internal webhook
# (empty disables it). docker compose sets this for its containers.
NEST_API_URL=http://api-gateway:3000
# Must equal INTERNAL_API_KEY in api-gateway/.env (at least 32 characters)
INTERNAL_API_KEY=
