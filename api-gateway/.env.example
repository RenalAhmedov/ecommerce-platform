NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=secret
DB_LOGGING=false

JWT_SECRET=
JWT_EXPIRES_IN=3600

# Shared with the admin service (its INTERNAL_API_KEY): authenticates its webhooks. At least 32 characters.
INTERNAL_API_KEY=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL_SECONDS=60

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM="Shop <no-reply@shop.local>"

RATE_LIMIT_ENABLED=true
# Comma-separated browser origins allowed to call the API, e.g. http://localhost:5173
CORS_ORIGINS=
# Proxies whose X-Forwarded-For is believed (Express "trust proxy"); private networks by default, where Nginx runs.
TRUST_PROXY=loopback, linklocal, uniquelocal
